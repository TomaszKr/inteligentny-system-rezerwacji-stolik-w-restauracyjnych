# ── Konfiguracja sieci Docker ─────────────────────────────
# Prefix podsieci dla app_network (subnet: ${NETWORK_PREFIX}.0/24).
# Użyj WOLNEGO zakresu z prywatnej puli RFC1918:
#   10.0.0.0/8  |  172.16.0.0–172.31.255.255  |  192.168.0.0/16
# Zmień jeśli koliduje z istniejącymi sieciami (sprawdź: docker network ls).
# Adresy statyczne: db=.10, backend=.11, nginx=.13
NETWORK_PREFIX=172.30.0

# Port hosta, na którym nginx wystawia aplikację (zmień jeśli 80 jest zajęty)
HTTP_PORT=80

# ── Baza danych (PostgreSQL) ──────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=changeme
DB_NAME=appdb
# Auto-sync schematu TypeORM. W PRODUKCJI ustaw 'false' i uruchamiaj migracje.
DB_SYNCHRONIZE=true

# ── CORS ──────────────────────────────────────────────────
# Lista dozwolonych origenów (po przecinku) dla WebSocket. Pusty = permisywny
# (połączenie i tak wymaga JWT). W produkcji ustaw origin frontendu.
CORS_ORIGIN=

# ── JWT ───────────────────────────────────────────────────
# WYMAGANE. Aplikacja NIE wystartuje bez tego. Wygeneruj silny, losowy sekret:
#   openssl rand -base64 48
JWT_SECRET=zmien-na-losowy-sekret-jwt

# ── Konto administratora (seed przy starcie) ──────────────
# Konto admina jest tworzone TYLKO gdy ADMIN_PASSWORD jest ustawione (min. 8 znaków).
# Bez ADMIN_PASSWORD seed jest pomijany (brak domyślnego hasła). Ustaw silne hasło.
ADMIN_EMAIL=admin@restaurant.local
ADMIN_PASSWORD=zmien-na-silne-haslo-admina

# ── Konfiguracja SMTP / Mail ──────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your-mailtrap-user
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=noreply@restaurant-app.com

# ── Rate limiting (ochrona przed DoS / spamem rezerwacji) ──
# TTL w milisekundach, MAX = liczba żądań na TTL z jednego IP.
# Limit prywatny — endpointy uwierzytelnione (rezerwacje, stoliki, admin)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
# Limit publiczny — endpointy bez JWT (auth: login/register); ostrzejszy
RATE_LIMIT_PUBLIC_TTL=60000
RATE_LIMIT_PUBLIC_MAX=10
