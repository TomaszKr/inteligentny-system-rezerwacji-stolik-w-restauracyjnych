# ── Konfiguracja sieci Docker ─────────────────────────────
# Prefix podsieci dla app_network (subnet: ${NETWORK_PREFIX}.0/24).
# Zmień jeśli zakres koliduje z istniejącymi sieciami Docker na hoście
# (np. 172.32.0). Adresy: db=.10, backend=.11, nginx=.13
NETWORK_PREFIX=172.20.0

# Port hosta, na którym nginx wystawia aplikację (zmień jeśli 80 jest zajęty)
HTTP_PORT=80

# ── Baza danych (PostgreSQL) ──────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=changeme
DB_NAME=appdb

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=zmien-na-losowy-sekret-jwt

# ── Konfiguracja SMTP / Mail ──────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your-mailtrap-user
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=noreply@restaurant-app.com
