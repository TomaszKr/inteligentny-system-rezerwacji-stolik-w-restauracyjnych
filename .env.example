# Konfiguracja sieci Docker
# Zmień jeśli ten zakres koliduje z istniejącymi sieciami na Twoim hoście
NETWORK_PREFIX=172.20.0

# Sekrety aplikacji
POSTGRES_DB=appdb
POSTGRES_USER=appuser
